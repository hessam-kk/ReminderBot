{
  "name": "reminder-bot",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "Telegram recurring-reminder bot on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply reminder-bot-db --local",
    "db:remote": "wrangler d1 migrations apply reminder-bot-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}